 #include <pthread.h>
 #include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+
+static int guac_rdp_image_quality_callback(guac_user* user, const char* mimetype,
+        const char* name, const char* value, void* data) {
+
+    if (!user->owner || strcmp(mimetype, "text/plain") != 0)
+        return 1;
+
+    char* end;
+    long quality = strtol(value, &end, 10);
+    if (quality < 30 || quality > 90 || *end != '\0')
+        return 1;
+
+    guac_client_set_lossy_quality_cap(user->client, (int) quality);
+    return 0;
+
+}
 
